# Copy to .env and fill in. .env is gitignored -- never commit real creds.
VBL_EMAIL=you@example.com
VBL_PASSWORD=your-password-here

# Mobile phone for the registration form (kept here, out of the repo).
VBL_PHONE=(314) 555 - 1234

# --- Payment (local only; NEVER commit; the bot fills these but does NOT
# --- click the final "Submit Payment" -- you do that yourself) ---
VBL_RECEIPT_EMAIL=you@example.com
VBL_CARD_NAME=Your Name
VBL_CARD_NUMBER=4111111111111111
VBL_CARD_EXP=12/28
VBL_CARD_CVV=123
VBL_CARD_ZIP=63101
